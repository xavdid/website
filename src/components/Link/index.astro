---
import "./link.scss";

type Props = {
  href: string;
  className?: string;
  active?: boolean;
  /**
   * passed by rehype when styling anchors
   */
  isHeading?: true;
  // provided by the footnote generator
  class?: string;
  "aria-label"?: string;
  id?: string;
};

const {
  href,
  className = "body-link",
  active,
  isHeading,
  class: generatedClassName,
  id,
} = Astro.props;
const ariaLabel = Astro.props["aria-label"];

// onClick={() => {
//     // log the event manually, but don't preventDefault()
//     count({
//       path: `ext-${href}`,
//       event: true,
//     });
//   }}
---

<a
  class:list={[
    isHeading ? "markdown-header" : className,
    active && "active",
    generatedClassName,
  ]}
  id={id}
  href={href}
  aria-label={ariaLabel}
  {...href.startsWith("/") || href.startsWith("#")
    ? {}
    : {
        target: "_blank",
      }}><slot /></a
>
