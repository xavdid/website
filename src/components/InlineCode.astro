<!-- global because it gets applied outside this component? even tough this is the component that renders everything? styles turned off when I pulled it though -->
<style lang="scss" is:global>
  @import "./vars.scss";

  // don't apply to code inside code fences
  :not(pre) > .inline-code {
    background-color: #dedede;
    padding: 3px;
    border-radius: 3px;
    font-size: 0.9rem;
    white-space: nowrap;
    @media (prefers-color-scheme: dark) {
      // color: $tBlack;
      background-color: unset;
      // because this is colored by a border in dark mode, it's a little wider than the normal background. so, less padding
      padding: 2px;
      border: 1px solid $tOrange;
    }
  }
</style>
<code class="inline-code"><slot /></code>
