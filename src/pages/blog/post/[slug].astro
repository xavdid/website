---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../components/layouts/BaseLayout/index.astro";

import AirtableLinkAndReturn from "../../../components/AirtableLinkAndReturn/index.astro";
import BlockquoteTitle from "../../../components/BlockquoteTitle/index.astro";
import InlineCode from "../../../components/InlineCode/index.astro";
import Link from "../../../components/Link/index.astro";
import MDXTable from "../../../components/MDXTable.astro";
import MediaYearLink from "../../../components/MediaYearLink.astro";
import ViewFullSize from "../../../components/ViewFullSize/index.astro";
import YoutubeEmbed from "../../../components/YoutubeEmbed/index.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  pageHeader={{
    title: post.data.title,
    date: post.data.date,
    tags: post.data.tags,
  }}
>
  <article>
    {"asdf"}
    <Content
      components={{
        // these will be used in place of the generic
        a: Link,
        code: InlineCode,
        table: MDXTable,
        // any other components here can be used in all mdx without imports
        // also add these in eslintrc
        YoutubeEmbed,
        BlockquoteTitle,
        AirtableLinkAndReturn,
        MediaYearLink,
        ViewFullSize,
        Link,
      }}
    />
  </article>
</BaseLayout>
