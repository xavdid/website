---
// import "./link.scss";

type Props = {
  href: string;
  className?: string;
  active?: boolean;
  /**
   * passed by rehype when styling anchors
   */
  isHeading?: true;
  // provided by the footnote generator
  class?: string;
  "aria-label"?: string;
  id?: string;
};

const {
  href,
  className = "body-link",
  active,
  isHeading,
  class: generatedClassName,
  id,
} = Astro.props;
const ariaLabel = Astro.props["aria-label"];

// onClick={() => {
//     // log the event manually, but don't preventDefault()
//     count({
//       path: `ext-${href}`,
//       event: true,
//     });
//   }}
---

<style lang="scss">
  @import "./vars.scss";

  $border-height: 2px;
  $link-color: #2f65a7;
  $dark-link-color: $tCyan;

  .body-link {
    text-decoration: none;
    line-height: 1.2; // without this, there's a weird floaty border
    color: $link-color;
    border-bottom: 1px solid lightgray;
    @media (prefers-color-scheme: dark) {
      color: $dark-link-color;
      border-bottom: 1px solid $tOrange;
    }
    display: inline-block; // this is the key to not having a newline after the link

    // pulled from https://github.com/YoussefRaafatNasry/portfolYOU/blob/ace3552e67f793a67a7e1598260900fc8b608947/_sass/_blog.scss#L75-L87
    &::after {
      content: "";
      display: block;
      height: 0.15rem;
      margin-top: -0.15rem;
      width: 0;
      background: $link-color;
      @media (prefers-color-scheme: dark) {
        background: $tOrange;
      }
      transition: width 0.2s;
    }

    &:hover::after {
      width: 100%;
    }

    &:visited {
      color: $link-color;
      @media (prefers-color-scheme: dark) {
        color: $dark-link-color;
      }
    }
  }
</style>

<a
  class:list={[
    isHeading ? "markdown-header" : className,
    active && "active",
    generatedClassName,
  ]}
  id={id}
  href={href}
  aria-label={ariaLabel}
  {...href.startsWith("/") || href.startsWith("#")
    ? {}
    : {
        target: "_blank",
      }}><slot /></a
>
