---
import Link from "../Link.astro";

// adapted from https://codepen.io/coderyang/pen/eJXXQg

import "./navbar.scss";

// https://www.cyishere.dev/blog/astro-active-nav-item - style active link
const {
  url: { pathname },
} = Astro;
---

<nav class="header">
  <Link href="/" className="header">
    <h1>David Brownman</h1>
  </Link>
  <div class="navbar">
    <Link href="/" className="navbar-item" active={pathname === "/"}>
      About
    </Link>
    <Link
      href="/blog"
      className="navbar-item"
      active={pathname.startsWith("/blog")}
    >
      Blog
    </Link>
    <Link
      href="/projects"
      className="navbar-item"
      active={pathname.startsWith("/projects")}
    >
      Projects
    </Link>
    <Link
      href="/contact"
      className="navbar-item"
      active={pathname.startsWith("/contact")}
    >
      Contact
    </Link>
  </div>
</nav>
