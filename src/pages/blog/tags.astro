---
// import { graphql, useStaticQuery } from "gatsby";

import Link from "../../components/Link/index.astro";
import PageHeader from "../../components/page-header.astro";

import Layout from "../../components/layouts/BaseLayout/index.astro";

import { getCollection } from "astro:content";

import "../../components/layouts/BaseLayout/table.scss";
import { slugify } from "../../util";

const posts = await getCollection("blog");

const tags = Object.values(
  posts.reduce<Record<string, { name: string; slug: string; num: number }>>(
    (res, post) => {
      for (const tag of post.data.tags) {
        const slug = slugify(tag);
        res[slug] ||= { name: tag, slug, num: 0 };
        res[slug].num += 1;
      }
      return res;
    },
    {},
  ),
).toSorted((a, b) => {
  if (b.num !== a.num) {
    return b.num - a.num;
  }

  // https://stackoverflow.com/questions/8996963/how-to-perform-case-insensitive-sorting-array-of-string-in-javascript#comment38960219_9645447
  return a.slug.localeCompare(b.slug, "en", { sensitivity: "base" });
});
---

<Layout pageHeader={{ title: "Tags" }} tabTitle="All Tags">
  <p>I've written on {tags.length} different topics.</p>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Tag</th>
          <th>Link</th>
          <th># posts</th>
        </tr>
      </thead>
      <tbody>
        {
          tags.map(({ name, slug, num }) => (
            <tr>
              <td>{name}</td>
              <td>
                <Link href={`/blog/tags/${slug}`}>see posts</Link>
              </td>
              <td> {num}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Layout>
