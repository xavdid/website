---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../components/layouts/BaseLayout/index.astro";

import AirtableLinkAndReturn from "../../../components/AirtableLinkAndReturn/index.astro";
// import BlockquoteTitle from "../../../components/BlockquoteTitle/index.jsx";
import InlineCode from "../../../components/InlineCode/index.astro";
import Link from "../../../components/Link/index.astro";
import MDXTable from "../../../components/MDXTable.astro";
// import MediaYearLink from "../../../components/MediaYearLink/index.jsx";
import Spoiler from "../../../components/Spoiler/index.jsx";
// import ViewFullSize from "../../../components/ViewFullSize/index.jsx";
import YoutubeEmbed from "../../../components/YoutubeEmbed/index.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout>
  <Content
    components={{
      // these will be used in place of the generic
      a: Link,
      code: InlineCode,
      table: MDXTable,
      // any other components here can be used in all mdx without imports
      // also add these in eslintrc
      YoutubeEmbed,
      // BlockquoteTitle,
      AirtableLinkAndReturn,
      // MediaYearLink,
      Spoiler,
      // ViewFullSize,
      Link,
    }}
  />
</BaseLayout>
