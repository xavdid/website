---
// this is used for non-blog pages, which wraps their frontmatter into actual layout props

import BaseLayout from "./BaseLayout/index.astro";

// generated by astro, but documented here for me
type Props = {
  file: string; // "/Users/david/projects/website/src/pages/projects.mdx";
  url: string; //  "/projects";
  content: {
    title: string; // "Projects";
    subtitle?: string; //"Big and Small";
    tab_title?: string; // "Home"
    file: string; //"/Users/david/projects/website/src/pages/projects.mdx";
    url: string; // "/projects";
  };
  frontmatter: {
    title: string; // "Projects";
    subtitle?: string; // "Big and Small";
    tab_title?: string; // "Home"
    file: string; //  "/Users/david/projects/website/src/pages/projects.mdx";
    url: string; // "/projects";
  };
  headings: { depth: number; slug: string; text: string }[];
};

const {
  frontmatter: { title, subtitle, tab_title },
} = Astro.props;
---

<BaseLayout
  tabTitle={tab_title ?? title}
  pageHeader={{
    title,
    subtitle,
  }}
>
  {/* <Seo title={frontmatter.seo_title || frontmatter.title} path={path} /> */}
  <slot />
</BaseLayout>
