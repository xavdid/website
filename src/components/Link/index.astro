---
// import { Link } from "gatsby";
// import { useGoatCounter } from "gatsby-plugin-goatcounter";
//

import "./link.scss";

type Props = {
  href: string;
  className?: string;
  active?: boolean;
};

const { href, className = "body-link", active } = Astro.props;

// onClick={() => {
//     // log the event manually, but don't preventDefault()
//     count({
//       path: `ext-${href}`,
//       event: true,
//     });
//   }}

// probably should just copy review's omnilink
---

<a
  class:list={[className, active && "active"]}
  href={href}
  {...href.startsWith("/") || href.startsWith("#")
    ? {}
    : {
        target: "_blank",
      }}><slot /></a
>
