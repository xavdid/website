<style lang="scss" is:global>
  @import "./vars.scss";

  .border {
    // doesn't look good on mobile with liquid glass, unfortunately
    // since my page now ends before the bottom of the screen so it cuts off weird
    display: none;
    @include desktop {
      display: inherit;
    }

    // farthest left
    background: $nav-background;
    // highlight color
    border-right: 0.15em solid $nav-item;
    @media (prefers-color-scheme: dark) {
      background: $nav-dark-background;
      border-right: 0.15em solid $nav-dark-item;
    }
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0.25em;
    z-index: -10;
  }
</style>
<div class="border"></div>
