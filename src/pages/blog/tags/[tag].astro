---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout/index.astro";
import Link from "../../../components/Link.astro";
import { getPublishedPosts, slugify } from "../../../util";
import BlogPostList from "../../../components/BlogPostList.astro";

type Props = {
  original: string;
};

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const tags = new Set<string>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      tags.add(tag);
    }
  }

  return [...tags].map((tag) => ({
    params: { tag: slugify(tag) },
    // we're filtering on the original value in posts
    props: { original: tag },
  }));
}

const { tag } = Astro.params;
const { original } = Astro.props;

// a little silly that we fetch these twice (here and in BlogPostList) but it's fine
const totalCount = (
  await getCollection("blog", (post) => post.data.tags.includes(original))
).length;

const tagHeader = `${totalCount === 1 ? "is" : "are"} ${totalCount} post${
  totalCount === 1 ? "" : "s"
}`;
---

<BaseLayout
  tabTitle={`Posts tagged ${tag}`}
  pageDescription={`Here are all the posts I've wrtten about ${tag}`}
  pageHeader={{
    title: `Posts tagged ${tag}`,
  }}
>
  <p>
    There {tagHeader} in this category. You can also view{" "}
    <Link href="/blog/tags">all tags</Link>.
  </p>
  <BlogPostList filterToTag={original} />
</BaseLayout>
