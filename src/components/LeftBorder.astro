<style lang="scss" is:global>
  @use "vars.scss";

  .border {
    // doesn't look good on mobile with liquid glass, unfortunately
    // since my page now ends before the bottom of the screen so it cuts off weird
    display: none;
    @include vars.desktop {
      display: inherit;
    }

    // farthest left
    background: vars.$nav-background;
    // highlight color
    border-right: 0.15em solid vars.$nav-item;
    @media (prefers-color-scheme: dark) {
      background: vars.$nav-dark-background;
      border-right: 0.15em solid vars.$nav-dark-item;
    }
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0.25em;
    z-index: -10;
  }
</style>
<div class="border"></div>
