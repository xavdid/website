---
import Link from "./Link.astro";

type Props = {
  items: string;
  verbed: string;
  year: string;
  link: string;
};

const { items, verbed, year, link } = Astro.props;
---

<hr />
<p style={{ textAlign: "center" }}>
  <em>
    See all the {items} I {verbed} during {year} (including ratings & reviews) on
    <Link href={link}>Airtable</Link>.
  </em>
</p>
