---
/**
 * nice little rounded link tag
 */
import { slugify } from "../util";
// import "./tag.scss";

type Props = {
  name: string;
};

const { name } = Astro.props;
---

<style lang="scss">
  @import "./vars.scss";

  .tag {
    padding: 2px 5px;
    margin-top: 2px;
    @include tablet {
      margin-top: 0;
    }
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 5px;

    color: $maize;
    background-color: $nav-background;
    @media (prefers-color-scheme: dark) {
      color: $MBlue;
      background-color: $maize;
    }
  }
</style>

<a class="tag" href={`/blog/tags/${slugify(name)}`}>
  {name}
</a>
