---
import Link from "./Link.astro";

type Props = {
  items: string;
  verbed: string;
  year: string;
};

const { items, verbed, year } = Astro.props;
---

<hr />
<p style={{ textAlign: "center" }}>
  <em>
    See all the {items} I {verbed} in {year} at{" "}
    <Link href={`https://david.reviews/${items}/years/${year}`}>
      david.reviews/{items}
    </Link>.
  </em>
</p>
